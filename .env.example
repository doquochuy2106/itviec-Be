PORT=8080
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ITViecClone

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET=your_access_token_secret
JWT_ACCESS_EXPIRE=15m

JWT_REFRESH_TOKEN_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=7d

# Initial Seed Data Configuration
SHOULD_INIT=true
INIT_PASSWORD=your_init_admin_password

# SMTP Mail Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_AUTH_USER=your_email@gmail.com
EMAIL_AUTH_PASS=your_gmail_app_password
EMAIL_PREVIEW=false

URL_FRONTEND=http://localhost:3000
